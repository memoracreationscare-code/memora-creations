NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5000
ADMIN_URL=http://localhost:5000/admin

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/memora_creations?retryWrites=true&w=majority

JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
COOKIE_NAME=memora_token
COOKIE_SAMESITE=lax

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_initial_password

# Cashfree online payments (sandbox or production)
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
# Sandbox-only admin refund initiation. Keep false unless testing refunds.
CASHFREE_SANDBOX_REFUNDS_ENABLED=false

# Legacy Razorpay endpoints (the checkout page uses Cashfree)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Password reset email (Resend)
RESEND_API_KEY=your_resend_api_key
MAIL_FROM="MEMORA CREATIONS <no-reply@example.com>"

# Optional: Shiprocket shipment tracking
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=

# Optional: WhatsApp Cloud API order notifications (off unless true)
WHATSAPP_SEND_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_TEMPLATE_ORDER_PLACED=
WHATSAPP_TEMPLATE_SHIPPED=
WHATSAPP_TEMPLATE_DELIVERED=

# Optional: gift wrapping (off unless true)
GIFT_WRAPPING_LIVE_ENABLED=false

DELIVERY_CHARGE=49
FREE_DELIVERY_THRESHOLD=499
CORS_ORIGIN=http://localhost:5000
